# ==========================================================================
#  PHP Blog — Apache configuration
# ==========================================================================

# No directory listings
Options -Indexes

# Deny direct access to sensitive files
<FilesMatch "(config\.php|config\.sample\.php|database\.sql|seed\.sql|Connection\.php|router\.php)">
    # Apache 2.4
    Require all denied
    # Apache 2.2 (only when the legacy module is available)
    <IfModule mod_access_compat.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ----------------------------------------------------------------------
    #  Force HTTPS
    #  The host terminates TLS at a reverse proxy, so we must also check the
    #  forwarded-protocol headers. The plain "%{HTTPS} off" check on its own
    #  causes an infinite redirect loop. (Rule from the InfinityFree docs.)
    #  Comment these three conditions out if you ever host without SSL.
    # ----------------------------------------------------------------------
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:CF-Visitor} !{"scheme":"https"}
    RewriteRule (.*) https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Never expose the git repository
    RewriteRule ^\.git(/.*)?$ - [F,L]

    # Serve real files/directories, route everything else through index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
</IfModule>

# Basic security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
